# Drop-in env for the EasyPanel Baserow stack.
# Copy to .env, fill in the secrets, paste into EasyPanel's env config,
# then deploy the compose file in deploy/baserow/docker-compose.easypanel.yml.

# Public URL Baserow runs at — add an EasyPanel domain that points here.
# Example: https://ops.ancsports.net
BASEROW_PUBLIC_URL=https://ops.ancsports.net

# Long random strings. Generate with `openssl rand -hex 32` (one per line).
BASEROW_SECRET_KEY=replace-me
BASEROW_JWT_SIGNING_KEY=replace-me
BASEROW_DB_PASSWORD=replace-me
BASEROW_REDIS_PASSWORD=replace-me
