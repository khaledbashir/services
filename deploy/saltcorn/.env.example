# Drop-in env for the EasyPanel Saltcorn stack.
# Copy to .env, fill in the secrets, paste into EasyPanel's env config,
# then deploy the compose file in deploy/saltcorn/docker-compose.easypanel.yml.

# Public URL Saltcorn runs at — add an EasyPanel domain pointing here.
SALTCORN_PUBLIC_URL=https://ops.ancsports.net

# Session secret — generate with: openssl rand -hex 32
SALTCORN_SESSION_SECRET=replace-me

# Postgres password — generate with: openssl rand -hex 24
SALTCORN_DB_PASSWORD=replace-me

# Iframe — comma-separated list of origins allowed to embed Saltcorn in an iframe.
# 'self' allows direct browsing; the second value lets services.ancsports.net iframe it.
SALTCORN_CSP_FRAME_ANCESTORS='self' https://services.ancsports.net
