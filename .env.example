# ANC Services Dashboard environment placeholders.
# Do not commit real production secrets.

DB_USER=ancservices
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anc_services
JWT_SECRET=change-me

# Microsoft Entra ID SSO
# Callback URL: https://services.ancsports.net/api/auth/callback/microsoft-entra-id
# The code also accepts AUTH_MICROSOFT_CLIENT_ID / AUTH_MICROSOFT_CLIENT_SECRET
# if you copy values from the current CRM Twenty env.
AUTH_MICROSOFT_ENTRA_ID_ID=your-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret-value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0/
AUTH_MICROSOFT_ALLOWED_DOMAINS=anc.com
NEXT_PUBLIC_MICROSOFT_SSO_ENABLED=false

# Optional: Services ticket replies can send through the same CRM-connected
# Microsoft support mailbox used by Twenty CRM.
TWENTY_CORE_DATABASE_URL=postgresql://user:password@abc_twenty-db:5432/default
SERVICES_SUPPORT_MAILBOX=support@anc.com
# SERVICES_SUPPORT_CONNECTED_ACCOUNT_ID=
# CRM_MICROSOFT_CLIENT_ID=
# CRM_MICROSOFT_CLIENT_SECRET=
